// NAS 컨테이너의 syslog 로그를 받아 Loki 로 보낸다.
// 구축 순서 2번 (Docs/plg_monitoring_design.md 10장) — 우선 chromadb 로 검증한다.
// 이후 couchdb-obsidian-sync · hyeseongkit-hub · hyeseongkit-jenkins 도 같은 방식으로 추가한다(한 번에 하나씩).
// 진행 상황(2026-08-24): 4개 전부 완료(검증됨) — chromadb·couchdb-obsidian-sync·hyeseongkit-hub·hyeseongkit-jenkins.

// 컨테이너가 logging.tag="{{.Name}}" 으로 보낸 이름이 RFC5424 APP-NAME 필드로 들어온다.
// 이 필드를 syslog 내부 라벨(__syslog_message_app_name)에서 꺼내 "container" 라벨로 승격한다.
loki.relabel "syslog_container" {
  forward_to = []

  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label  = "container"
  }
}

loki.source.syslog "docker" {
  listener {
    address                = "0.0.0.0:51400"
    protocol                = "udp"
    // chromadb 는 syslog-address 에 syslog-format=rfc5424 를 명시한다(docker
    // inspect 로 확인) — 그래서 여기 rfc5424 가 맞다. 🔴 개발 PC 쪽 bifrost·
    // open-webui 는 syslog-format 을 지정하지 않아 Docker 기본값(RFC3164 형태,
    // monitoring/devpc/config.alloy 에서 raw 소켓으로 실측)으로 나가므로 그쪽만
    // rfc3164 를 쓴다. 컨테이너마다 syslog-format 지정 여부를 반드시 먼저
    // 확인할 것 — 하나의 값으로 통일할 수 없다.
    syslog_format            = "rfc5424"
    label_structured_data   = true
    labels                  = { job = "docker" }
  }

  relabel_rules = loki.relabel.syslog_container.rules
  forward_to    = [loki.process.redact.receiver]
}

// 12-3 2차 방어 — chromadb·couchdb·jenkins 처럼 우리가 고칠 수 없는 컨테이너는
// 여기서만 시크릿을 막을 수 있다. src/logger_setup.py 의 RedactFilter 와 같은 패턴을 쓴다.
// 패턴을 바꾸면 양쪽(1차·2차)에 반영할 것 — 12-3 참조.
loki.process "redact" {
  forward_to = [loki.write.default.receiver]

  stage.replace {
    expression = `(?i)(api[_-]?key\s*[=:]\s*)\S+`
    replace    = "${1}<REDACTED>"
  }
  stage.replace {
    expression = `(?i)(bearer\s+)[A-Za-z0-9._\-]{8,}`
    replace    = "${1}<REDACTED>"
  }
  stage.replace {
    expression = `(?i)(authorization\s*[=:]\s*)\S+`
    replace    = "${1}<REDACTED>"
  }
  stage.replace {
    expression = `(?i)(token\s*[=:]\s*)\S+`
    replace    = "${1}<REDACTED>"
  }
  stage.replace {
    expression = `(?i)(webhook[s]?/)[A-Za-z0-9._\-/]+`
    replace    = "${1}<REDACTED>"
  }
  stage.replace {
    expression = `sk-[A-Za-z0-9]{16,}`
    replace    = "<REDACTED>"
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
