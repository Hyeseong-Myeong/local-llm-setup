# 🔴 참고용 문서일 뿐이다 — 이 값들로 실제 .env 파일을 만들어 쓰지 않는다.
# 배포는 monitoring/nas/Jenkinsfile 을 통해서만 하고, 아래 각 항목은 전부
# Jenkins Credentials 에 등록해 그쪽에서 주입한다(Jenkinsfile 상단 주석 참조).
# 여기 있는 설명(왜 필요한지, 어떻게 만드는지)은 Credentials 등록할 때 참고할 것.

# NAS 의 Tailscale IP. Grafana(13000)와 Prometheus(13090, remote-write 수신용)가
# 이 인터페이스에 바인딩한다. Loki(13100)는 루프백 전용이라 여기 안 넣는다 (K10).
TAILNET_BIND_IP=

# Grafana admin 비밀번호. 기본값(admin/admin)을 쓰지 않는다 — 8-3 항목 1.
# tailnet 안 기기 하나가 뚫리면 그 다음 방어선이 이 비밀번호뿐이다.
GF_SECURITY_ADMIN_PASSWORD=

# 세션 쿠키 서명 키. 기본값을 쓰면 세션 쿠키를 위조할 수 있다 — 8-3 항목 4.
# 생성 예: openssl rand -hex 32
GF_SECURITY_SECRET_KEY=

# Grafana Alerting → Discord (9장). 심각도별로 채널을 분리한다 — 하나로 몰면
# 일반 알림 소음에 크리티컬이 묻힌다(9-2). 채널별 웹훅 URL을 각각 발급할 것.
DISCORD_WEBHOOK_URL_INFO=
DISCORD_WEBHOOK_URL_WARNING=
DISCORD_WEBHOOK_URL_ERROR=
