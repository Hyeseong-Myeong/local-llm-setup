# NAS 의 Tailscale IP. 개발 PC Alloy 가 이 주소로 remote-write 를 push 한다(6-1).
# monitoring/nas/.env 의 TAILNET_BIND_IP 와 같은 값이어야 한다.
NAS_TAILNET_IP=

# Bifrost 관리자 계정 (governance_config 테이블에 이미 있음 — Web UI 에서 설정한 값).
# Alloy 가 /metrics 를 basic_auth 로 긁을 때 쓴다(6-3). 화이트리스트가 아니라
# 인증을 유지하기로 결정했으므로 이 값이 없으면 Bifrost 스크랩은 401 로 실패한다.
BIFROST_ADMIN_USER=
BIFROST_ADMIN_PASSWORD=
