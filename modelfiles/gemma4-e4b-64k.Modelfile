# gemma4:e4b + 컨텍스트 65,536
#
# 근거 (2026-08-22 실측):
#   num_ctx  4,096 -> 3.30GB (100% GPU)
#   num_ctx 16,384 -> 3.32GB (100% GPU)
#   num_ctx 32,768 -> 3.33GB (100% GPU)
#   num_ctx 65,536 -> 3.37GB (100% GPU) · bge-m3 동거 가능
# 컨텍스트를 16배 늘려도 적재 크기가 0.07GB 만 는다 — KV 캐시 효율이 매우 좋다.
# 디스크 크기(9.6GB)와 적재 크기(3.3GB)가 크게 다르므로 디스크 크기로 판단하지 말 것.
#
# 65,536 을 고른 이유: 검증된 값 중 가장 크고, 임베딩 동거에도 여유가 크다.
# 모델 최대 컨텍스트는 131,072 이므로 더 올릴 여지가 있으나 실측하지 않았다.
#
# top_p / temperature / top_k 는 원본에서 상속되므로 재지정하지 않는다.
FROM gemma4:e4b
PARAMETER num_ctx 65536
