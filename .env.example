VAULT_PATH=D:\LLM\Obsidian
CHROMA_HOST=
CHROMA_PORT=8000
# 앞단 프록시(Caddy) 인증 토큰. 비우면 무인증으로 접속한다.
# NAS의 /volume1/docker/chromadb/.env 와 반드시 같은 값이어야 한다.
CHROMA_TOKEN=

MODEL_NAME=qwen3.5:9b

# (주의) 리전을 US로 선택했다면 host 주소는 https://us.cloud.langfuse.com 입니다.
# 만약 EU로 선택했다면 https://cloud.langfuse.com 입니다. (대시보드에 표시된 호스트 주소 복사)
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="https://jp.cloud.langfuse.com"

# 에러 발생 시 알림을 받을 디스코드 웹훅 주소를 입력하세요.
DISCORD_WEBHOOK_URL=""

# 디스코드 봇 토큰 (URL 스크래핑 및 RAW 전달용)
DISCORD_BOT_TOKEN=""

# ANTHROPIC_API_KEY="..."
GEMINI_API_KEY="..."

# Bifrost Gateway 및 Ollama 연결 정보 (하드코딩 방지용)
BIFROST_BASE_URL=""
BIFROST_API_KEY=""
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Bifrost 컨테이너가 바인딩할 호스트 IP. 기본값(127.0.0.1)은 이 PC에서만 접근 가능.
# Tailscale로 다른 기기에서 접근하려면 이 PC의 Tailscale IP로 설정하세요.
# (주의: docker-compose 포트 매핑은 "어느 인터페이스에 열지"만 제어하며, 특정
# 원격 기기만 허용하는 화이트리스트가 아닙니다. 접근 기기 제한은 Tailscale ACL로 하세요.)
BIFROST_BIND_IP="127.0.0.1"
TOOL_SERVER_API_KEY="super_secret_wiki_key_2026"

# 향후 확장을 위한 외부 API Key (Bifrost 연동)
GROQ_API_KEY=""
CEREBRAS_API_KEY=""
MISTRAL_API_KEY=""
ANTHROPIC_API_KEY=""
